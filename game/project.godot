; Apex — online competitive racing
; Godot 4.4 project configuration.
; Edited as text only: no setting here may depend on the GUI editor.

config_version=5

[application]

config/name="Apex"
config/description="Online competitive racing with car building and setup."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
boot_splash/show_image=false
config/quit_on_go_back=false

[autoload]

Log="*res://core/log.gd"
GameConfig="*res://core/game_config.gd"
DataRegistry="*res://core/data_registry.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/return_value_discarded=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[input]

throttle={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":87)
, Object(InputEventKey,"device":-1,"physical_keycode":4194320)
, Object(InputEventJoypadMotion,"device":-1,"axis":5,"axis_value":1.0)
]
}
brake={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":83)
, Object(InputEventKey,"device":-1,"physical_keycode":4194322)
, Object(InputEventJoypadMotion,"device":-1,"axis":4,"axis_value":1.0)
]
}
steer_left={
"deadzone": 0.15,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":65)
, Object(InputEventKey,"device":-1,"physical_keycode":4194319)
, Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":-1.0)
]
}
steer_right={
"deadzone": 0.15,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":68)
, Object(InputEventKey,"device":-1,"physical_keycode":4194321)
, Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":1.0)
]
}
energy_boost={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194325)
, Object(InputEventJoypadButton,"device":-1,"button_index":0)
]
}
pit_request={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":80)
, Object(InputEventJoypadButton,"device":-1,"button_index":3)
]
}
camera_cycle={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":67)
, Object(InputEventJoypadButton,"device":-1,"button_index":2)
]
}
look_back={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194306)
, Object(InputEventJoypadButton,"device":-1,"button_index":1)
]
}
reset_car={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":82)
]
}
pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194305)
, Object(InputEventJoypadButton,"device":-1,"button_index":6)
]
}

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=16

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
